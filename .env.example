DB_HOST=localhost
DB_PORT=5432
DB_NAME=securevault
DB_USERNAME=securevault
DB_PASSWORD=changeme

# Generate a real value with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-value-at-least-32-bytes
JWT_EXPIRATION_MINUTES=60

# Per client IP, shared between /api/auth/login and /api/auth/register
AUTH_RATE_LIMIT_PER_MINUTE=10

# Where uploaded files are stored (outside any web-served directory)
STORAGE_ROOT=./data/storage

SERVER_PORT=8080

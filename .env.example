DB_HOST=localhost
DB_PORT=5432
DB_NAME=securevault
DB_USERNAME=securevault
# Required - the app and docker compose refuse to start without it.
# Fine for local dev; use a strong unique value anywhere else.
DB_PASSWORD=changeme

# Generate a real value with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-value-at-least-32-bytes
JWT_EXPIRATION_MINUTES=60

# Per client IP, shared between /api/auth/login and /api/auth/register
AUTH_RATE_LIMIT_PER_MINUTE=10

# Where uploaded files are stored (outside any web-served directory)
STORAGE_ROOT=./data/storage

# Total storage allowed per user across all their documents
STORAGE_QUOTA_PER_USER=1GB

SERVER_PORT=8080
